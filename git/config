# See https://git-scm.com/docs/git-config
[user]
	name = aradix
	email = 444nt000@proton.me
	signingkey = ~/.ssh/id_ed25519.pub
[core]
	editor = nvim
[commit]
	gpgsign = true
	verbose = true
[gpg]
	format = ssh
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[rerere]
	enabled = true
	autoupdate = true
